# ============================================================
# SIMAR — Environment Variables
# Copy file ini menjadi .env.local dan isi value-nya
# ============================================================

# === Database Configuration ===
# Gunakan URL PostgreSQL standar.
# Contoh URL Supabase: postgresql://postgres.[project-ref]:[password]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL="postgresql://user:password@localhost:5432/dbname?schema=public"

# === Admin Authentication ===
# Hash dari password admin (Gunakan bcrypt, 12 rounds)
ADMIN_PASSWORD_HASH="$2a$12$..."

# ─── Node Environment ────────────────────────────────────────
# Set 'production' saat deploy ke server
NODE_ENV=development
